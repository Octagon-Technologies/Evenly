<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: permits plain-HTTP/WS traffic to a local `supabase start` Docker stack, so emulator
     testing can point at localhost instead of the metered cloud project (see SupabaseConfig.USE_LOCAL).
     10.0.2.2 is the Android emulator's alias for the host machine's loopback; 127.0.0.1 covers the iOS
     Simulator / a device on the host itself. This manifest merges into debug builds only — release
     traffic is untouched and stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
