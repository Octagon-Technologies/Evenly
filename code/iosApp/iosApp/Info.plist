<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Export compliance. The app's only cryptography is OS-provided and exempt: HTTPS/TLS to Supabase
	     and Firebase, plus Keychain on iOS (Android Keystore AES-GCM on the other platform). There is no
	     custom or bundled crypto. Declaring it here is what stops every TestFlight build parking in
	     "Missing Compliance" until the questionnaire is answered by hand. Revisit if the app ever ships
	     its own encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Home-screen name. The bundle is app.splitevenly; the product the user sees is "Evenly". -->
	<key>CFBundleDisplayName</key>
	<string>Evenly</string>
	<!-- Receipt capture (D-22). iOS shows these strings in its own permission prompt (this IS the
	     "explain why" step). WITHOUT NSCameraUsageDescription the app HARD-CRASHES (SIGABRT) the moment
	     the camera opens on a real device — the simulator is guarded out, which is why it only surfaced
	     on a physical device. Photos go through PHPicker (out-of-process, no auth), but the library
	     string is declared defensively for any direct-library path. -->
	<key>NSCameraUsageDescription</key>
	<string>Evenly uses your camera to snap receipts, so you can split a bill by scanning it. Photos stay on your device and are only attached to the expense you add them to.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Evenly accesses the photos you choose so you can attach receipts to an expense. Only the photos you pick are used.</string>
	<!-- OAuth / magic-link redirect target (splitevenly://login-callback). Must match the Auth deep
	     link in SupabaseClientFactory + the Supabase Auth URL allow-list. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.splitevenly.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>splitevenly</string>
			</array>
		</dict>
	</array>
	<!-- Silent pushes wake the app to pull fresh group data (PushController). Inert until the Push
	     Notifications capability adds `aps-environment` to the entitlements - see PUSH_SETUP.md. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Payment-app deep links the settle flow opens (iOS requires apps to declare schemes it queries). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>venmo</string>
		<string>cashapp</string>
	</array>
	<!-- Branded launch screen: the white feather on brand blue, matching Theme.Evenly.Splash on
	     Android and EvenlySplashBlue in Compose. White-on-blue needs no dark-mode variant, and the
	     Compose SplashScreen picks up the same blue so the hand-off is one continuous screen. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
