# Copy to `.env.local` (gitignored) for local development, and set the same three in the Vercel
# project's environment variables. See README.md for where each value comes from.

# The `admin` edge function. Every byte of data the dashboard shows comes through it.
VITE_ADMIN_FN_URL=https://wfpfgbipjmkysalfmyub.supabase.co/functions/v1/admin

# Supabase Auth, used for Google OAuth and nothing else. The anon key is publishable by design and
# reads nothing here: every table this dashboard touches has RLS on with no policies and grants
# revoked, so the key is a login credential and not a data credential.
VITE_SUPABASE_URL=https://wfpfgbipjmkysalfmyub.supabase.co
VITE_SUPABASE_ANON_KEY=
